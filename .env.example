# =============================================================================
# .env.example – Required Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values:
#   copy .env.example .env
#
# NEVER commit the actual .env file to Git!
# =============================================================================

# Flask secret key – used for session signing and CSRF protection.
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# (Optional) Override the default image tag for docker-compose deployment.
# This is set automatically by deploy.ps1 but you can override it here.
# IMAGE_TAG=latest
